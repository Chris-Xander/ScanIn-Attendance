rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(adminId) {
      return isSignedIn() && request.auth.uid == adminId;
    }

    // Users can access self-docs
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Admin-owned collections (queries allowed via frontend where("adminId", "==", uid))
    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.adminId);
    }

    match /participants/{participantId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.adminId);
    }

    match /sessionMemberData/{metaId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.adminId);
    }

    match /members/{memberId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.adminId);
    }

    match /qrGateReports/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.adminId);
    }

    match /customQRCodes/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.adminId);
    }

    // Public collection
    match /scanForms/{formId} {
      allow read: if true;
      allow write: if false;
    }

    // Subscriptions (self only)
    match /subscriptions/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Payments (locked down)
    match /payments/{doc} {
      allow read, write: if false;
    }

    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
